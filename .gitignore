node_modules
dist
# Credential files. `.env` alone is not enough: Vite's loadEnv (see
# server/standalone/vite.config.js) and scripts/setup-doctor.mjs both read the
# full dotenv ladder — .env, .env.local, .env.<mode> and .env.<mode>.local —
# so a key placed in any of them is live for the app. Only .env was ignored,
# leaving the other three committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
# Browser QA gate evidence (screenshots, console and network dumps).
qa-artifacts/
# Playwright MCP session logs: browser consoles can carry tokens in URLs.
.playwright-mcp/
# Local Claude Code settings and preview configs.
.claude/
.DS_Store
.gstack/
3d-models/
pinokio/ENVIRONMENT
pinokio/.installed

# SPECTRE: optional non-commercial datasets fetched by
# scripts/fetch-optional-data.ps1. Never commit or ship them in the default build.
src/data/local_data/telegeography_submarine_cables/

# SPECTRE intel service: virtualenv, local database, the user's own feed
# overrides and tool/fetch logs stay on this machine.
intel/.venv/
intel/data/
intel/feeds.local.yaml
__pycache__/
.spectre-logs/
.skynet-logs/

# Transient: a release interrupted mid-assembly (npm run changelog recovers it)
changelog.d/.assembling/
